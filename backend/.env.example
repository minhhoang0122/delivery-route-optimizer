# Sao chép file này thành .env rồi điền giá trị. File .env không đưa lên git.

# Cổng của Backend API (Vite chuyển tiếp /api về cổng này)
PORT=3000

# PostgreSQL: dùng role lastmile_app, không dùng postgres
PGHOST=localhost
PGPORT=5433
PGDATABASE=lastmile
PGUSER=lastmile_app
PGPASSWORD=

# Chuỗi bí mật để ký JWT, ít nhất 16 ký tự, mỗi máy một chuỗi riêng
JWT_SECRET=

# Khóa TomTom (để trống thì chặng thiếu được ước lượng và bản đồ nền dùng OpenStreetMap)
TOMTOM_API_KEY=

# Nguồn ma trận thời gian (phụ thuộc giờ): replay | tomtom | mock
#  replay: dùng lại các khung giờ TomTom đã ghi (16:00, 16:30, 17:00, 17:30), chỉ lấy thêm chặng còn thiếu
#  tomtom: lấy theo giao thông lúc bắt đầu ca và thêm một khung sau đó MATRIX_SECOND_SLOT_MINUTES phút khi lập kế hoạch,
#          dùng lại chặng của khung gần đó lấy trong MATRIX_REUSE_MINUTES phút
#  mock:   ước lượng theo khoảng cách, chỉ để chạy thử
MATRIX_SOURCE=replay
MATRIX_REUSE_MINUTES=30
MATRIX_SECOND_SLOT_MINUTES=60

# Ca làm việc: giờ hết ca mặc định khi lập kế hoạch (giờ bắt đầu mặc định là bây giờ) và độ lệch giờ địa phương (phút)
SHIFT_END=18:00
TZ_OFFSET_MINUTES=420

# Thời gian phục vụ (giây): mỗi lần dừng ở một điểm và mỗi đơn giao tại điểm đó; dùng cho lập kế hoạch, giờ dự kiến, đổi tuyến
STOP_SECONDS=90
SERVICE_SECONDS_PER_ORDER=90

# Giới hạn tính toán của Local Search (số phép đánh giá, mili giây)
LS_MAX_EVALUATIONS=100000
LS_MAX_MS=2000

# Kiểm tra đổi tuyến tự động theo chu kỳ (giây), mặc định 120, 0 là tắt. Mỗi chu kỳ so thời gian các chặng nối tiếp
# theo thứ tự hiện hành với lúc lập tuyến; chỉ khi tăng vượt ngưỡng mới gọi TomTom thêm cho các chặng còn lại và chặng
# từ vị trí xe. Thứ tự mới đạt ngưỡng tiết kiệm thì hệ thống tự áp dụng, Dispatcher không phải duyệt
REROUTE_CHECK_SECONDS=120

# Lệch tuyến: xe cách đường đi của tuyến quá OFF_ROUTE_METERS ở ít nhất OFF_ROUTE_POSITIONS vị trí liên tiếp kéo dài ít nhất
# OFF_ROUTE_SECONDS giây thì hệ thống sắp lại các điểm còn lại từ vị trí xe (OFF_ROUTE_SECONDS=0: chỉ xét số vị trí)
OFF_ROUTE_METERS=300
OFF_ROUTE_SECONDS=60
OFF_ROUTE_POSITIONS=2

# Trang theo dõi đơn của khách (không đăng nhập): số lần đọc và số lần hẹn lại tối đa mỗi phút từ một địa chỉ IP;
# xe cách điểm giao trong TRACKING_ARRIVING_M mét thì khách không hẹn lại được nữa
TRACKING_READS_PER_MINUTE=30
TRACKING_WRITES_PER_MINUTE=5
TRACKING_ARRIVING_M=300

# Việc cần xử lý trên màn hình Tổng quan của điều phối viên
#  POSITION_STALE_SECONDS: vị trí xe cũ hơn ngần này giây thì báo (tài xế mở ứng dụng chỉ đường làm vị trí tạm dừng)
#  ASSIGNED_IDLE_MINUTES: chuyến đã phân nhưng chưa xuất phát quá ngần này phút
#  TRIP_LATE_MINUTES: giờ về kho dự kiến trễ hơn kế hoạch quá ngần này phút
#  FAILED_ALERT_MINUTES: lần giao chưa thành công trong ngần này phút gần nhất (để gọi khách khi tài xế còn ở gần)
POSITION_STALE_SECONDS=180
ASSIGNED_IDLE_MINUTES=30
TRIP_LATE_MINUTES=10
FAILED_ALERT_MINUTES=30

# Đơn chưa giao được tự giao lại ở kế hoạch sau tối đa ngần này lần; quá số lần thì điều phối viên quyết định
MAX_DELIVERY_ATTEMPTS=3
# Vị trí có sai số lớn hơn ngần này mét thì bỏ
POSITION_MAX_ACCURACY_M=100
# Kết quả giao ghi khi xe cách điểm giao xa hơn ngần này mét thì đánh dấu trên chi tiết chuyến
POD_MAX_DISTANCE_M=200

# npm run test:flow ghi dữ liệu vào cơ sở dữ liệu nên chỉ chạy khi FLOW_TEST_ALLOW=1. Không đặt biến này ở đây;
# đặt nó cùng PGDATABASE/PGPORT của cơ sở dữ liệu thử trong terminal khi chạy kiểm thử (xem README)

# Mật khẩu chung của các tài khoản mẫu do npm run seed tạo (chỉ dùng trên máy phát triển)
SEED_PASSWORD=GiaoHang@2026
